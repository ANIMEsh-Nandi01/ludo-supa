# ============================================================
# Supabase — get these from your Supabase project settings
# ============================================================

# Project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co

# Public anon key (Settings → API → anon public)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon-key

# ============================================================
# TURN / STUN server (for WebRTC voice chat)
# You can use a free TURN server or Xirsys / Metered.ca
# ============================================================

# TURN server URL  e.g. turn:your-turn-server.com:3478
VITE_TURN_URL=turn:turn.example.com:3478

# TURN credentials
VITE_TURN_USERNAME=ludouser
VITE_TURN_CREDENTIAL=supersecretpassword
